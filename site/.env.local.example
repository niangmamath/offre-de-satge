# Base de données Supabase (Postgres) — Settings -> Database -> Connection string.
# Pour le SITE (Vercel, environnement serverless), utilisez le "connection
# pooler" (Transaction mode, port 6543) plutôt que la connexion directe
# (port 5432) : Settings -> Database -> Connection pooling sur Supabase.
# Le pipeline Python (GitHub Actions) peut utiliser l'une ou l'autre (c'est
# un run séquentiel unique, pas concurrent).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Administration du site (/admin) — mot de passe unique, un seul admin.
ADMIN_PASSWORD=change-moi

# Optionnel : permet les boutons "Lancer maintenant" dans /admin pour
# déclencher scrape.yml / newsletter.yml sans passer par GitHub. Créer un
# personal access token "fine-grained" limité à CE dépôt uniquement, avec
# la permission "Actions: Read and write" (rien d'autre) —
# github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxx